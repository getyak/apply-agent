FROM python:3.12-slim
WORKDIR /app
COPY agents/pyproject.toml agents/README.md ./agents/
RUN pip install --no-cache-dir uv && cd agents && uv sync --no-dev
COPY agents agents
ENV PATH=/app/agents/.venv/bin:$PATH PYTHONPATH=/app
EXPOSE 8000
CMD ["uvicorn", "agents.api.server:app", "--host", "0.0.0.0", "--port", "8000"]
